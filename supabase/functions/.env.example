# Copy to supabase/functions/.env for `pnpm fn:serve`. In production set these
# with `supabase secrets set`. Never commit the real file.

# Which AI provider the functions use: gemini | anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids for the active provider (check the provider's model list).
# Cheap model: exercises and corrections. Capable model: dialogues and explanations.
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.8-flash
# Speech-to-text for the oral dialogue (always Gemini: it accepts audio input).
AI_MODEL_TRANSCRIBE=gemini-3.5-flash-lite
# Anthropic equivalents: AI_MODEL_FAST=claude-haiku-5-5, AI_MODEL_SMART=claude-sonnet-5-5

# Daily reminders (send-reminders). Generate the keys with: pnpm push:keys
# VAPID_KEYS is the private key pair (base64 of JSON); the public key goes to the PWA as VITE_VAPID_PUBLIC_KEY.
VAPID_KEYS=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret that pg_cron sends in the x-cron-secret header (same value as the Vault secret reminders_secret).
CRON_SECRET=
