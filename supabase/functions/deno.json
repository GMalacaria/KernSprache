{
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "include": ["no-explicit-any"],
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 120
  },
  "exclude": ["_shared/database.types.ts"]
}
